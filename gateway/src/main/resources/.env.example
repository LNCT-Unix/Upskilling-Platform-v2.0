# Copy this file to .env and fill in your local values.
# .env is loaded by application.properties via:
#   spring.config.import=optional:classpath:.env[.properties]

# Server
SERVER_PORT=8080

# CORS (comma-separated origin patterns allowed to call this API)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# PostgreSQL datasource
DB_URL=jdbc:postgresql://localhost:5432/ai_upskilling
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (secret must be Base64 encoded and >= 32 bytes for HS256)
# Generate one with:
#   powershell: [Convert]::ToBase64String((New-Object byte[] 48 | % { [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($_) }))
JWT_SECRET=replace-with-base64-secret
JWT_EXPIRATION_MS=86400000

# Skill DAG
DAG_MASTERY_THRESHOLD=0.75
